{
  "name": "counterpart",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "vitest run",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && npm run build:ui && node infra/copy-assets.mjs",
    "start": "node dist/src/index.js",
    "dynamo:up": "docker run -d --rm --name counterpart-dynamo -p 8000:8000 amazon/dynamodb-local -jar DynamoDBLocal.jar -sharedDb -inMemory",
    "dynamo:down": "docker stop counterpart-dynamo",
    "test:dynamo": "cross-env DYNAMODB_ENDPOINT=http://localhost:8000 vitest run test/integration/dynamo-store.test.ts",
    "seed": "tsx seed/cli.ts",
    "token": "tsx infra/create-token.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:ui": "cross-env UI_NAME=snapshot vite build --config ui/vite.config.ts && cross-env UI_NAME=sales-report vite build --config ui/vite.config.ts && cross-env UI_NAME=setup vite build --config ui/vite.config.ts",
    "smoke": "tsx infra/smoke.ts",
    "golden": "tsx infra/golden/cli.ts",
    "business:check": "tsx seed/business-cli.ts check",
    "business:add": "tsx seed/business-cli.ts add",
    "business:new": "tsx seed/business-cli.ts new",
    "deploy": "bash infra/deploy.sh",
    "teardown": "bash infra/teardown.sh",
    "predev": "npm run build:ui"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "private": "true",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1141.0",
    "@aws-sdk/client-dynamodb": "^3.1133.0",
    "@aws-sdk/lib-dynamodb": "^3.1133.0",
    "@modelcontextprotocol/express": "2.0.0",
    "@modelcontextprotocol/ext-apps": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "express": "^5.1.0",
    "yaml": "^2",
    "zod": "^4.2"
  },
  "devDependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1140.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.3",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^6.4.3",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.1"
  }
}
